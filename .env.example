# ================================================================
#  TechLife VoiceBridge Enterprise — Environment Configuration
#  Copy to .env and fill in your values
# ================================================================

# Server
SERVER_IP=YOUR_SERVER_IP
SIP_DOMAIN=YOUR_SIP_DOMAIN
API_PORT=4000
WS_PORT=8765
WEBHOOK_PORT=5000
DASHBOARD_PORT=3000
ESL_PORT=8776
LOG_DIR=/var/log/techlife
LOG_LEVEL=info

# CouchDB
COUCH_URL=http://admin:PASSWORD@127.0.0.1:5984

# Super Admin (auto-created on first run)
SUPERADMIN_EMAIL=superadmin@techlife.ai
SUPERADMIN_PASS=SuperAdmin@2024

# JWT
JWT_SECRET=CHANGE_THIS_TO_64_RANDOM_CHARS
JWT_EXPIRES=12h

# ── AI Vendors ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
DEEPSEEK_API_KEY=
IBM_WATSON_API_KEY=
IBM_WX_URL=https://us-south.ml.cloud.ibm.com
IBM_WX_PROJECT_ID=

# ── ASR Vendors ───────────────────────────────────────────────
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
WHISPER_MODEL=medium
PYTHON_BIN=/opt/techlife-voicebridge/venv/bin/python3

# ── Translation Vendors ───────────────────────────────────────
DEEPL_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
LIBRETRANSLATE_URL=https://libretranslate.de
LIBRETRANSLATE_KEY=

# ── TTS Vendors ───────────────────────────────────────────────
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ── Email (report delivery) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@techlife.ai
