# ================================================================
#  TechLife VoiceBridge Enterprise — .env
# ================================================================

# Server
SERVER_IP=192.168.0.85
API_PORT=4000
WS_PORT=8765
WEBHOOK_PORT=5000
DASHBOARD_PORT=3000

# CouchDB
# NOTE: special characters in the password (like @) must be percent-encoded
# in a URL. "WELcome@123" -> "WELcome%40123". Node's own URL parser tolerates
# the raw "@" here, but other tools (curl, some CouchDB clients) may not, so
# it's encoded below to avoid confusion. If you change the CouchDB admin
# password, re-encode any special characters the same way.
COUCH_URL=http://admin:WELcome%40123@127.0.0.1:5984

# JWT
JWT_SECRET=CHANGE_THIS_TO_64_RANDOM_CHARS_IN_PRODUCTION
JWT_EXPIRES=12h

# Super Admin (created on first run)
SUPERADMIN_EMAIL=superadmin@techlife.ai
SUPERADMIN_PASS=SuperAdmin@2024

# ── AI Vendors ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
OPENAI_API_KEY=sk-
DEEPSEEK_API_KEY=
IBM_WATSON_API_KEY=
IBM_WATSON_URL=https://api.us-south.speech-to-text.watson.cloud.ibm.com

# ── ASR Vendors ───────────────────────────────────────────────
DEEPGRAM_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
GOOGLE_APPLICATION_CREDENTIALS=

# ── Translation Vendors ───────────────────────────────────────
DEEPL_API_KEY=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus
LIBRETRANSLATE_URL=https://libretranslate.de
LIBRETRANSLATE_KEY=

# ── TTS Vendors ───────────────────────────────────────────────
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
ELEVENLABS_API_KEY=
GOOGLE_TTS_CREDENTIALS=
IBM_TTS_KEY=
IBM_TTS_URL=https://api.us-south.text-to-speech.watson.cloud.ibm.com

# ── Whisper (local) ───────────────────────────────────────────
WHISPER_MODEL=medium
#PYTHON_BIN=/opt/techlife-voicebridge/venv/bin/python3
PYTHON_BIN=/usr/bin/python3
# ── Email (reports) ──────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@techlife.ai

# ── Misc ──────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=/var/log/techlife
